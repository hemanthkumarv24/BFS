# Frontend Environment Variables
VITE_API_URL=http://localhost:5000/api
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# Backend Environment Variables
PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key

# Optional: Enhanced geocoding services (backend)
MAPBOX_API_KEY=your_mapbox_api_key_here
OPENCAGE_API_KEY=your_opencage_api_key_here

# Telegram Bot Configuration (backend)
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of admin chat IDs (use npm run test:telegram to find IDs)
TELEGRAM_ADMIN_CHAT_IDS=123456789,987654321
# Frontend URL for order links in notifications
FRONTEND_URL=http://localhost:3000

# Development mode (bypass pincode restrictions)
DEV_MODE=false
