# Database
MONGO_URI=mongodb://localhost:27017/bubbleflash

# JWT Secret (use a secure random string)
JWT_SECRET=your_jwt_secret_here

# Google OAuth (Get these from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Base URL for frontend redirects
BASE_URL=http://localhost:3000

# Server Port
PORT=5000

# Email configuration (for OTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Google Maps API (for address autocomplete)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Telegram Bot Configuration (for admin notifications)
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of admin chat IDs (use test:telegram script to find IDs)
TELEGRAM_ADMIN_CHAT_IDS=123456789,987654321
